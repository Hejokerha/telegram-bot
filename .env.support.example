# Copy to .env.support locally, or set these variables on the existing Render service.
# Create a NEW bot via the verified @BotFather; never reuse BOT_TOKEN.
SUPPORT_BOT_ENABLED=false
SUPPORT_BOT_TOKEN=
SUPPORT_OPENAI_API_KEY=
SUPPORT_OPENAI_MODEL=gpt-6.1-sol

# Owner-only pilot by default. Comma-separated Telegram IDs for other testers.
SUPPORT_ADMIN_TELEGRAM_ID=1582593617
SUPPORT_ALLOWED_TELEGRAM_IDS=
SUPPORT_BOT_PUBLIC=false

# Reservations count failed API attempts too. Day boundary is UTC.
SUPPORT_DAILY_TOTAL=20
SUPPORT_DAILY_PER_USER=10
SUPPORT_COOLDOWN_SECONDS=10
SUPPORT_MAX_OUTPUT_TOKENS=1600

# Use a writable persistent disk path on Render to preserve quotas/tickets.
# For the existing Render service without a disk, set SUPPORT_STORE_BACKEND=firebase.
# Firebase state lives only under system/support_bot; user accounts remain read-only.
SUPPORT_STORE_BACKEND=sqlite
# Do not point multiple replicas at this SQLite file. One service instance only.
# SUPPORT_DB_PATH=/var/data/support/support.sqlite3
